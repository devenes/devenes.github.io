---
import rawEvents from '../../data/events.json';
import rawLocations from '../../data/locations.json';
import { SPEAKER_PROFILE } from '../data/speakerProfile';
import { buildSpeakingAtlas, serializeClientAtlas } from '../utils/geography';
import { withBase } from '../utils/paths';
import TopNav from '../components/TopNav.astro';
import HeroOverview from '../components/HeroOverview.astro';
import DestinationPanel from '../components/DestinationPanel.astro';
import RecentSignals from '../components/RecentSignals.astro';
import SignalDrawer from '../components/SignalDrawer.astro';
import ArchiveMatrix from '../components/ArchiveMatrix.astro';
import AboutModal from '../components/AboutModal.astro';

const atlas = buildSpeakingAtlas(rawEvents, rawLocations);
const clientAtlasPayload = serializeClientAtlas(atlas);
const initialEvent = atlas.events[0];
const siteTitle = 'Enes Turan — Cloud, Kubernetes & AI';
const siteDescription = `Talks, workshops, and conference notes by Enes Turan (Software Engineer at JumpCloud, Google Developer Expert) across ${atlas.metrics.uniqueCities} cities and ${atlas.metrics.uniqueCountries} countries.`;
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://devenes.github.io';
const canonicalUrl = new URL(withBase(''), `${siteOrigin}/`).toString();
const ogImageUrl = new URL(withBase('images/og-home.jpg'), `${siteOrigin}/`).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SPEAKER_PROFILE.name,
  jobTitle: `${SPEAKER_PROFILE.jobTitle} & ${SPEAKER_PROFILE.recognition}`,
  worksFor: {
    '@type': 'Organization',
    name: SPEAKER_PROFILE.company,
  },
  image: new URL(withBase(SPEAKER_PROFILE.headshots[0].assetPath), `${siteOrigin}/`).toString(),
  url: canonicalUrl,
  sameAs: SPEAKER_PROFILE.socialLinks.map((s) => s.url),
};
---

<!doctype html>
<html
  lang="en"
  class="dark bg-[#0B0C0E] text-[#F4F1EA] antialiased selection:bg-[#E2A84B]/30 selection:text-[#F4F1EA]"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Enes Turan" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Enes Turan — Cloud, Kubernetes & AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@thedevenes" />
    <meta name="twitter:creator" content="@thedevenes" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link
      rel="preload"
      href={withBase('fonts/plus-jakarta-sans-normal-400-700-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('fonts/newsreader-normal-400-600-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={withBase('fonts/fonts.css')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg-canvas: #0b0c0e;
        --bg-surface: #121417;
        --ink-primary: #f4f1ea;
        --ink-secondary: #c6c2b8;
        --ink-muted: #9c978c;
        --accent: #e2a84b;
        --scrollbar-thumb: rgba(198, 194, 184, 0.24);
        --scrollbar-track: #0b0c0e;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        line-height: 1.5;
        background-color: var(--bg-canvas);
        color: var(--ink-primary);
        overflow-x: hidden;
        font-size-adjust: from-font;
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
      }
      .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
      }
      @supports not (scrollbar-color: auto) {
        ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }
        ::-webkit-scrollbar-track {
          background: var(--scrollbar-track);
        }
        ::-webkit-scrollbar-thumb {
          background: var(--scrollbar-thumb);
          border-radius: 9999px;
        }
      }
      h1,
      h2 {
        text-wrap: balance;
        font-size-adjust: cap-height from-font;
      }
      p,
      li {
        text-wrap: pretty;
        overflow-wrap: break-word;
      }
      .tabular-nums {
        font-variant-numeric: tabular-nums;
      }
      /* Accessible tab indicator driven directly from ARIA state (persists in Forced Colors Mode) */
      [role='tab'] {
        position: relative;
        color: var(--ink-muted);
      }
      [role='tab']:hover {
        color: var(--ink-primary);
      }
      [role='tab'][aria-selected='true'] {
        color: var(--ink-primary);
      }
      [role='tab'][aria-selected='true']::after {
        content: '';
        position: absolute;
        inset: auto 0.5rem 0;
        border-block-end: 2px solid var(--accent);
      }
      /* Filter pill toggle state driven from aria-pressed */
      .filter-pill[aria-pressed='true'] {
        background-color: rgba(28, 31, 36, 0.95);
        color: var(--ink-primary);
        border-color: rgba(226, 168, 75, 0.65);
        backdrop-filter: blur(8px);
      }
      .filter-pill[aria-pressed='false'] {
        background-color: rgba(18, 20, 23, 0.85);
        color: var(--ink-secondary);
        border-color: rgba(244, 241, 234, 0.14);
        backdrop-filter: blur(8px);
      }
      .filter-pill[aria-pressed='false']:hover {
        background-color: rgba(28, 31, 36, 0.92);
        color: var(--ink-primary);
      }
      dialog:modal {
        overscroll-behavior: contain;
      }
      dialog::backdrop {
        overflow: hidden;
        overscroll-behavior: contain;
        background-color: rgba(8, 9, 11, 0.76);
        backdrop-filter: blur(8px);
      }
      .soft-edge-fade-y {
        overflow-y: auto;
        -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 90%, transparent 100%);
      }
      .soft-edge-fade-x {
        overflow-x: auto;
        -webkit-mask-image: linear-gradient(to right, black 95%, transparent 100%);
        mask-image: linear-gradient(to right, black 95%, transparent 100%);
      }
      .visually-hidden:where(:not(:focus-within, :active)) {
        position: absolute !important;
        clip-path: inset(50%) !important;
        overflow: hidden !important;
        width: 1px !important;
        height: 1px !important;
        margin: -1px !important;
        padding: 0 !important;
        border: 0 !important;
        white-space: nowrap !important;
      }
      :where(a:any-link, button, select, input, [role='button'], [role='tab']):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      @media (forced-colors: active) {
        [role='tab'][aria-selected='true']::after {
          border-block-end-color: Highlight;
        }
        .filter-pill[aria-pressed='true'] {
          outline: 2px solid Highlight;
        }
        :where(a:any-link, button, select, input, [role='button'], [role='tab']):focus-visible {
          outline-color: Highlight;
        }
      }
    </style>
  </head>

  <body
    id="top"
    data-view-mode="globe"
    data-selected-city=""
    data-year="all"
    data-topic="all"
    class="relative min-h-screen w-full bg-[#0B0C0E] text-[#F4F1EA] flex flex-col justify-between overflow-x-hidden"
  >
    <a
      href="#main-content"
      class="visually-hidden fixed top-3 left-4 z-[60] rounded-md bg-[#F4F1EA] px-3.5 py-2 text-xs font-semibold text-[#0B0C0E] shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Restrained Dark-Room Vignette Backdrop (No synthetic dot grids) -->
    <div
      class="fixed inset-0 z-0 pointer-events-none"
      style="background: radial-gradient(circle at 50% 44%, #151921 0%, #0E1014 44%, #0B0C0E 82%);"
      aria-hidden="true"
    >
    </div>

    <!-- Center Interactive 3D Earth Viewport -->
    <div
      id="orbit-canvas-container"
      data-testid="orbit-canvas-container"
      class="fixed inset-0 z-[1]"
      aria-label="Interactive 3D Earth map of speaking locations"
    >
    </div>

    <!-- Editorial Masthead Navigation -->
    <TopNav totalTalks={atlas.metrics.totalTalks} />

    <!-- Main Three-Zone Workspace -->
    <main
      id="main-content"
      tabindex="-1"
      class="relative z-20 flex-1 w-full max-w-[1560px] mx-auto pt-20 md:pt-24 lg:pt-[5.5rem] pb-2 px-5 lg:px-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 lg:gap-8 pointer-events-none focus:outline-none"
    >
      <!-- Left Column: Speaker Identity & Real Numbers -->
      <div class="w-full lg:w-[380px] xl:w-[410px] shrink-0">
        <HeroOverview atlas={atlas} />
      </div>

      <!-- Center Column: Mobile/Tablet Globe Window & Desktop Breathing Space -->
      <div
        id="mobile-globe-viewport"
        class="w-full h-[250px] sm:h-[290px] lg:h-auto lg:flex-1 lg:min-h-[380px] flex items-end justify-center pb-2 pointer-events-none select-none"
      >
        <div
          id="mobile-globe-hint-pill"
          class="lg:hidden flex flex-wrap items-center justify-center gap-2 rounded-full px-3.5 py-1.5 bg-[#121417]/90 backdrop-blur-md border border-[#F4F1EA]/18 shadow-lg pointer-events-auto"
        >
          <span class="text-xs text-[#C6C2B8]">Drag globe · Tap a city</span>
          <span class="h-3 w-[1px] bg-[#F4F1EA]/18" aria-hidden="true"></span>
          <button
            type="button"
            data-action="reset-city"
            class="text-xs text-[#C6C2B8] hover:text-[#F4F1EA] px-1.5 py-0.5 rounded transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button
            type="button"
            data-action="toggle-motion"
            aria-pressed="false"
            class="text-xs text-[#C6C2B8] hover:text-[#F4F1EA] px-1.5 py-0.5 rounded transition-colors cursor-pointer"
          >
            Pause
          </button>
        </div>
      </div>

      <!-- Right Column: Focused Geographic Explorer -->
      <DestinationPanel atlas={atlas} />
    </main>

    <!-- Bottom Chronological Talk Strip -->
    <RecentSignals atlas={atlas} />

    <!-- Slide-Over Talk Detail Sheet -->
    <SignalDrawer initialEvent={initialEvent} />

    <!-- Full Searchable Talks Archive Dialog -->
    <ArchiveMatrix atlas={atlas} />

    <!-- Speaker Bio Dialog -->
    <AboutModal atlas={atlas} />

    <!-- Build-Time Slimmed Atlas Data Payload -->
    <script
      id="speaking-atlas-data"
      type="application/json"
      set:html={JSON.stringify(clientAtlasPayload)}
    />

    <!-- Client-Side Interactive State & Deferred 3D Earth Initialization -->
    <script>
      import { initSpeakingAtlasApp } from '../scripts/atlasController';
      import { hydrateClientAtlas, type ClientSpeakingAtlasPayload } from '../utils/geography';

      function bootstrap() {
        const atlasEl = document.getElementById('speaking-atlas-data');
        if (!atlasEl?.textContent) return;
        try {
          const payload = JSON.parse(atlasEl.textContent) as ClientSpeakingAtlasPayload;
          const atlas = hydrateClientAtlas(payload);
          initSpeakingAtlasApp(atlas, null);
        } catch (err) {
          console.error('Failed to initialize speaking map:', err);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootstrap);
      } else {
        bootstrap();
      }
    </script>
  </body>
</html>
