---
import type { SpeakingAtlasData } from '../utils/geography';
import { formatSignalDate } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { metrics, cities, regions, topics, years, events } = atlas;
const prominentCities = cities.slice(0, 8);
---

<!-- 2D Projected City Marker Labels on the 3D Earth -->
<div
  id="globe-city-labels"
  class="fixed inset-0 z-10 pointer-events-none overflow-hidden"
>
  {
    cities.map((city) => (
      <div
        data-globe-city-label={city.id}
        data-visible="false"
        style="transform: translate3d(-9999px, -9999px, 0); opacity: 0;"
        class="absolute top-0 left-0 transition-opacity duration-200"
      >
        <button
          type="button"
          data-action="select-city"
          data-city-id={city.id}
          data-testid={`globe-city-${city.id}`}
          aria-label={`Select ${city.city}, ${city.country} (${city.eventsCount} ${city.eventsCount === 1 ? 'talk' : 'talks'})`}
          class={`group -translate-x-1/2 -translate-y-full -mt-2 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs backdrop-blur-md border transition-colors cursor-pointer shadow-[0_4px_14px_rgba(0,0,0,0.65)] ${
            city.isBaseHub
              ? 'bg-[#181B20]/95 text-[#F4F1EA] border-[#E2A84B]/70'
              : 'bg-[#121417]/88 hover:bg-[#181B20] text-[#E6E2D8] border-[#F4F1EA]/18 hover:border-[#E2A84B]/55'
          }`}
        >
          <span
            class={`h-1.5 w-1.5 rounded-full ${
              city.isBaseHub
                ? 'bg-[#E2A84B]'
                : city.eventsCount >= 2
                  ? 'bg-[#F3D08A]'
                  : 'bg-[#A39E93]'
            }`}
          />
          <span class="font-medium tracking-tight whitespace-nowrap">
            {city.city}
          </span>
          {city.eventsCount > 1 && (
            <span class="font-mono text-[0.6875rem] text-[#C6C2B8] tabular-nums">
              {city.eventsCount}
            </span>
          )}
        </button>
      </div>
    ))
  }
</div>

<!-- Floating Globe Camera & Motion Controls -->
<div
  id="globe-controls-toolbar"
  class="fixed bottom-[194px] left-1/2 -translate-x-1/2 z-20 hidden lg:flex items-center gap-1 rounded-full px-3 py-1 bg-[#121417]/90 backdrop-blur-md border border-[#F4F1EA]/16 shadow-lg pointer-events-auto"
  role="toolbar"
  aria-label="Globe camera and motion controls"
>
  <button
    type="button"
    data-action="globe-zoom-in"
    data-testid="globe-zoom-in"
    aria-label="Zoom in on globe"
    class="min-h-[1.625rem] min-w-[1.625rem] px-1.5 rounded-full flex items-center justify-center text-xs font-mono text-[#C6C2B8] hover:text-[#F4F1EA] hover:bg-[#F4F1EA]/10 transition-colors cursor-pointer"
  >
    +
  </button>
  <button
    type="button"
    data-action="globe-zoom-out"
    data-testid="globe-zoom-out"
    aria-label="Zoom out on globe"
    class="min-h-[1.625rem] min-w-[1.625rem] px-1.5 rounded-full flex items-center justify-center text-xs font-mono text-[#C6C2B8] hover:text-[#F4F1EA] hover:bg-[#F4F1EA]/10 transition-colors cursor-pointer"
  >
    −
  </button>
  <div class="h-3.5 w-[1px] bg-[#F4F1EA]/14 mx-0.5" aria-hidden="true"></div>
  <button
    type="button"
    data-action="reset-city"
    data-testid="globe-reset-view"
    class="px-2.5 py-0.5 rounded-full text-xs text-[#C6C2B8] hover:text-[#F4F1EA] hover:bg-[#F4F1EA]/10 transition-colors cursor-pointer"
  >
    Reset view
  </button>
  <div class="h-3.5 w-[1px] bg-[#F4F1EA]/14 mx-0.5" aria-hidden="true"></div>
  <button
    type="button"
    id="toggle-motion-btn"
    data-action="toggle-motion"
    data-testid="toggle-motion-btn"
    aria-pressed="false"
    class="px-2.5 py-0.5 rounded-full text-xs text-[#C6C2B8] hover:text-[#F4F1EA] hover:bg-[#F4F1EA]/10 transition-colors cursor-pointer"
  >
    Pause motion
  </button>
</div>

<!-- Right Column: Single Focused Geographic Explorer (No duplicate mini-map widget) -->
<aside
  id="right-discovery-column"
  aria-label="Speaking locations and topic filters"
  class="relative z-20 flex flex-col w-full lg:w-[360px] xl:w-[380px] shrink-0 pointer-events-auto"
>
  <div
    id="destination-panel"
    data-testid="destination-panel"
    aria-live="polite"
    class="rounded-xl bg-[#121417]/92 backdrop-blur-xl border border-[#F4F1EA]/14 shadow-[0_18px_44px_rgba(0,0,0,0.65)] overflow-hidden"
  >
    <!-- Editorial 4-Mode Tab Bar (Zero Emojis) -->
    <div
      id="view-mode-tablist"
      class="grid grid-cols-4 border-b border-[#F4F1EA]/12 bg-[#16191E]/80 px-1"
      role="tablist"
      aria-label="Browse speaking locations by view"
    >
      <button
        type="button"
        id="mode-tab-globe"
        role="tab"
        aria-selected="true"
        data-view-mode="globe"
        data-testid="mode-btn-globe"
        class="view-mode-btn py-2.5 px-2 text-xs font-medium text-center transition-colors cursor-pointer"
      >
        Places
      </button>
      <button
        type="button"
        id="mode-tab-regions"
        role="tab"
        aria-selected="false"
        data-view-mode="regions"
        data-testid="mode-btn-regions"
        class="view-mode-btn py-2.5 px-2 text-xs font-medium text-center transition-colors cursor-pointer"
      >
        Regions
      </button>
      <button
        type="button"
        id="mode-tab-timeline"
        role="tab"
        aria-selected="false"
        data-view-mode="timeline"
        data-testid="mode-btn-timeline"
        class="view-mode-btn py-2.5 px-2 text-xs font-medium text-center transition-colors cursor-pointer"
      >
        Years
      </button>
      <button
        type="button"
        id="mode-tab-topics"
        role="tab"
        aria-selected="false"
        data-view-mode="topics"
        data-testid="mode-btn-topics"
        class="view-mode-btn py-2.5 px-2 text-xs font-medium text-center transition-colors cursor-pointer"
      >
        Topics
      </button>
    </div>

    <!-- 1A. DEFAULT PLACES OVERVIEW (When no city is selected) -->
    <div
      id="city-overview-state"
      data-testid="city-overview-state"
      role="tabpanel"
      aria-labelledby="mode-tab-globe"
      class="p-4 sm:p-5"
    >
      <div class="flex items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-medium text-[#F4F1EA]">
          Speaking locations
        </h2>
        <span class="font-mono text-xs text-[#9C978C] tabular-nums">
          {metrics.uniqueCities} cities
        </span>
      </div>
      <p class="mt-1 text-xs text-[#C6C2B8] leading-[1.5]">
        Select a pin on the globe or pick a stop below to see talks and session notes from that
        city.
      </p>

      <!-- City Dropdown -->
      <div class="mt-3.5">
        <label for="city-selector-dropdown" class="sr-only">
          Select a speaking city
        </label>
        <select
          id="city-selector-dropdown"
          data-testid="city-selector-dropdown"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] px-3 py-2 text-xs text-[#F4F1EA] focus:outline-none"
        >
          <option value="">Jump to any of {metrics.uniqueCities} cities...</option>
          {
            cities.map((c) => (
              <option value={c.id}>
                {c.city}, {c.country} ({c.eventsCount}{' '}
                {c.eventsCount === 1 ? 'talk' : 'talks'})
              </option>
            ))
          }
        </select>
      </div>

      <!-- Frequent Stops -->
      <div class="mt-4">
        <div class="text-xs font-medium text-[#9C978C] mb-2">
          Frequent stops
        </div>
        <div class="flex flex-wrap gap-1.5">
          {
            prominentCities.map((c) => (
              <button
                type="button"
                data-action="select-city"
                data-city-id={c.id}
                data-testid={`prominent-city-${c.id}`}
                class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs bg-[#181B20] hover:bg-[#22262D] text-[#E6E2D8] hover:text-[#F4F1EA] border border-[#F4F1EA]/12 hover:border-[#E2A84B]/55 transition-colors cursor-pointer"
              >
                <span>{c.city}</span>
                <span class="font-mono text-[0.6875rem] text-[#E2A84B] tabular-nums">
                  {c.eventsCount}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 1B. SELECTED CITY PANEL (Clean Typographic Header, No Fake Skyline SVG) -->
    <div
      id="selected-city-panel"
      data-testid="selected-city-panel"
      role="tabpanel"
      aria-labelledby="mode-tab-globe"
      hidden
      class="hidden flex-col"
    >
      <div class="relative px-4 sm:px-5 pt-4 pb-3.5 border-b border-[#F4F1EA]/12 bg-[#16191E]/55">
        <div class="flex items-center justify-between gap-2 pr-9">
          <span
            id="selected-city-region-badge"
            class="text-xs font-medium text-[#E2A84B]"
          >
            Türkiye
          </span>
          <span
            id="selected-city-coords"
            class="font-mono text-[0.6875rem] text-[#9C978C] tabular-nums"
          >
            41.01°N, 28.98°E
          </span>
        </div>

        <button
          type="button"
          data-action="reset-city"
          data-testid="reset-city-btn"
          aria-label="Close city panel and view all locations"
          class="absolute top-3.5 right-3.5 flex min-h-[1.75rem] min-w-[1.75rem] items-center justify-center rounded-md bg-[#0B0C0E]/70 hover:bg-[#22262D] border border-[#F4F1EA]/18 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-sm leading-none"
        >
          ×
        </button>

        <div class="mt-1.5">
          <h2
            id="selected-city-name"
            data-testid="selected-city-name"
            class="font-display text-2xl font-medium text-[#F4F1EA] leading-[1.15]"
          >
            Istanbul
          </h2>
          <p
            id="selected-city-country"
            data-testid="selected-city-country"
            class="text-xs text-[#C6C2B8] flex items-center gap-1.5 mt-0.5"
          >
            <span>🇹🇷</span>
            <span>Türkiye</span>
          </p>
        </div>
      </div>

      <!-- City Sub-Tabs (Photos tab stays hidden unless real photos exist for this city) -->
      <div
        id="selected-city-tablist"
        role="tablist"
        aria-label="Selected city sections"
        class="flex border-b border-[#F4F1EA]/12 bg-[#0B0C0E]/45 px-2 text-xs"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-city-tab="talks"
          id="city-tab-btn-talks"
          class="flex-1 py-2 px-3 text-center font-medium cursor-pointer tabular-nums"
        >
          <span id="selected-city-talks-count">7 talks</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-city-tab="photos"
          id="city-tab-btn-photos"
          hidden
          class="hidden flex-1 py-2 px-3 text-center font-medium cursor-pointer"
        >
          Photos
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-city-tab="about"
          id="city-tab-btn-about"
          class="flex-1 py-2 px-3 text-center font-medium cursor-pointer"
        >
          Details
        </button>
      </div>

      <!-- City Tabpanel: Talks -->
      <div
        id="city-tab-content-talks"
        role="tabpanel"
        aria-labelledby="city-tab-btn-talks"
        class="p-4 space-y-2 max-h-[250px] overflow-y-auto soft-edge-fade-y"
      >
        <div id="selected-city-events-list" data-testid="selected-city-events-list" class="space-y-2">
        </div>
      </div>

      <!-- City Tabpanel: Photos (Only reachable when authentic photos exist) -->
      <div
        id="city-tab-content-photos"
        role="tabpanel"
        aria-labelledby="city-tab-btn-photos"
        hidden
        class="hidden p-4 max-h-[250px] overflow-y-auto soft-edge-fade-y"
      >
        <div id="selected-city-photos-content" class="text-xs text-[#C6C2B8]"></div>
      </div>

      <!-- City Tabpanel: Details -->
      <div
        id="city-tab-content-about"
        role="tabpanel"
        aria-labelledby="city-tab-btn-about"
        hidden
        class="hidden p-4 max-h-[250px] overflow-y-auto soft-edge-fade-y"
      >
        <div id="selected-city-about-content" class="text-xs text-[#C6C2B8] space-y-2"></div>
      </div>

      <div class="p-3.5 border-t border-[#F4F1EA]/12 bg-[#0B0C0E]/35">
        <button
          type="button"
          id="selected-city-archive-btn"
          data-testid="selected-city-archive-btn"
          class="w-full rounded-md py-2 px-3.5 text-xs font-medium text-[#E6E2D8] hover:text-[#F4F1EA] bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 transition-colors cursor-pointer"
        >
          View all talks in Istanbul →
        </button>
      </div>
    </div>

    <!-- 2. REGIONS PANEL -->
    <div
      id="view-panel-regions"
      data-testid="view-panel-regions"
      role="tabpanel"
      aria-labelledby="mode-tab-regions"
      hidden
      class="hidden p-4 sm:p-5 space-y-3 max-h-[380px] overflow-y-auto soft-edge-fade-y"
    >
      <div class="flex items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-medium text-[#F4F1EA]">Regions</h2>
        <button
          type="button"
          data-action="filter-region"
          data-region-id="all"
          class="text-xs text-[#9C978C] hover:text-[#E2A84B] transition-colors cursor-pointer tabular-nums"
        >
          Show all ({metrics.uniqueCities} cities)
        </button>
      </div>
      <div class="space-y-2.5">
        {
          regions.map((reg) => (
            <div
              data-region-card={reg.id}
              class="rounded-lg p-3 bg-[#181B20]/75 border border-[#F4F1EA]/12 transition-colors"
            >
              <div class="flex items-center justify-between gap-2">
                <button
                  type="button"
                  data-action="filter-region"
                  data-region-id={reg.id}
                  aria-pressed="false"
                  class="text-left text-sm font-semibold text-[#F4F1EA] hover:text-[#E2A84B] transition-colors cursor-pointer flex items-center gap-2"
                >
                  <span
                    class="h-2 w-2 rounded-full shrink-0"
                    style={`background-color: ${reg.color};`}
                  />
                  <span>{reg.name}</span>
                </button>
                <span class="font-mono text-xs text-[#9C978C] tabular-nums">
                  {reg.talksCount} talks · {reg.citiesCount} cities
                </span>
              </div>
              <div class="mt-2 flex flex-wrap gap-1.5">
                {reg.cities.map((c) => (
                  <button
                    type="button"
                    data-action="select-city"
                    data-city-id={c.id}
                    class="rounded px-2 py-0.5 text-xs bg-[#0B0C0E]/70 hover:bg-[#22262D] text-[#C6C2B8] hover:text-[#F4F1EA] border border-[#F4F1EA]/10 cursor-pointer tabular-nums"
                  >
                    {c.city} ({c.eventsCount})
                  </button>
                ))}
              </div>
            </div>
          ))
        }

        <div class="rounded-lg p-3 bg-[#181B20]/50 border border-[#F4F1EA]/12">
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-semibold text-[#E6E2D8]">
              Online &amp; Global Broadcasts
            </span>
            <span class="font-mono text-xs text-[#C6C2B8] tabular-nums">
              {metrics.onlineTalks} talks
            </span>
          </div>
          <p class="mt-1 text-xs text-[#9C978C] leading-[1.5]">
            Remote keynotes, streams, and university sessions—counted in total talks ({metrics.totalTalks}),
            not pinned to physical coordinates.
          </p>
        </div>
      </div>
    </div>

    <!-- 3. YEARS PANEL -->
    <div
      id="view-panel-timeline"
      data-testid="view-panel-timeline"
      role="tabpanel"
      aria-labelledby="mode-tab-timeline"
      hidden
      class="hidden p-4 sm:p-5 space-y-3 max-h-[380px] overflow-y-auto"
    >
      <div class="flex items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-medium text-[#F4F1EA]">By year</h2>
        <span class="font-mono text-xs text-[#9C978C] tabular-nums">2023–2026</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-action="select-year"
          data-year="all"
          aria-pressed="true"
          class="filter-pill year-filter-pill rounded-md px-2.5 py-1 font-mono text-xs border cursor-pointer transition-colors tabular-nums"
        >
          All ({metrics.totalTalks})
        </button>
        {
          years.map((y) => (
            <button
              type="button"
              data-action="select-year"
              data-year={y.year}
              aria-pressed="false"
              class="filter-pill year-filter-pill rounded-md px-2.5 py-1 font-mono text-xs border cursor-pointer transition-colors tabular-nums"
            >
              {y.year} ({y.talksCount})
            </button>
          ))
        }
      </div>
      <p id="timeline-era-narrative" class="text-xs text-[#C6C2B8] leading-[1.5]">
        {metrics.totalTalks} sessions from 2023 to 2026 across cloud architecture, GKE internals,
        and multi-agent AI systems.
      </p>
      <div
        id="timeline-panel-events-list"
        class="pt-2.5 border-t border-[#F4F1EA]/12 space-y-1.5 max-h-[185px] overflow-y-auto soft-edge-fade-y"
      >
        {
          events.map((ev) => (
            <button
              type="button"
              data-action="open-event"
              data-event-id={ev.id}
              data-timeline-panel-item
              data-year={ev.year}
              data-topics={ev.topicCategories.join(',')}
              class="w-full flex items-center justify-between gap-2 rounded-lg p-2.5 bg-[#181B20]/75 hover:bg-[#22262D] border border-[#F4F1EA]/10 hover:border-[#E2A84B]/45 text-left transition-colors cursor-pointer"
            >
              <div class="min-w-0">
                <div class="font-mono text-[0.6875rem] text-[#9C978C]">
                  {formatSignalDate(ev.date)} · {ev.cityName}
                </div>
                <div class="text-xs font-semibold text-[#F4F1EA] truncate mt-0.5">
                  {ev.talk}
                </div>
                <div class="text-xs text-[#9C978C] truncate">{ev.event}</div>
              </div>
              <span class="text-[#9C978C] text-xs shrink-0" aria-hidden="true">
                →
              </span>
            </button>
          ))
        }
        <div
          id="timeline-panel-empty-state"
          class="hidden py-6 text-center text-xs text-[#9C978C]"
        >
          <p>No talks match the active year and topic filters.</p>
          <button
            type="button"
            data-action="clear-timeline-filters"
            class="mt-2 text-xs font-medium text-[#E2A84B] hover:underline cursor-pointer"
          >
            Reset filters
          </button>
        </div>
      </div>
    </div>

    <!-- 4. TOPICS PANEL -->
    <div
      id="view-panel-topics"
      data-testid="view-panel-topics"
      role="tabpanel"
      aria-labelledby="mode-tab-topics"
      hidden
      class="hidden p-4 sm:p-5 space-y-3 max-h-[380px] overflow-y-auto soft-edge-fade-y"
    >
      <div class="flex items-baseline justify-between gap-2">
        <h2 class="font-display text-lg font-medium text-[#F4F1EA]">Topics</h2>
        <button
          type="button"
          data-action="select-topic"
          data-topic="all"
          class="text-xs text-[#9C978C] hover:text-[#E2A84B] transition-colors cursor-pointer"
        >
          Clear filter
        </button>
      </div>
      <p class="text-xs text-[#C6C2B8] leading-[1.5]">
        Filter the map and talk list by focus area. Cross-disciplinary sessions (like{' '}
        <em>Kubernetes for AI</em>) appear in more than one group.
      </p>
      <div class="space-y-2">
        {
          topics.map((t) => (
            <button
              type="button"
              data-action="select-topic"
              data-topic={t.id}
              data-testid={`topic-card-${t.id}`}
              aria-pressed="false"
              class="filter-pill w-full rounded-lg p-3 border text-left transition-colors cursor-pointer"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs sm:text-sm font-semibold text-[#F4F1EA] flex items-center gap-2">
                  <span
                    class="h-2 w-2 rounded-full shrink-0"
                    style={`background-color: ${t.color};`}
                  />
                  <span>{t.label}</span>
                </span>
                <span class="font-mono text-xs text-[#E2A84B] tabular-nums">
                  {t.talksCount}
                </span>
              </div>
              <div class="mt-1 text-xs text-[#9C978C] pl-4">
                {t.subLabel} · {t.citiesCount} cities
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</aside>
