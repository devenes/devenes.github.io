---
interface Props {
  totalTalks: number;
}

const { totalTalks } = Astro.props;
---

<header
  class="fixed top-0 inset-x-0 z-30 h-16 md:h-20 px-5 lg:px-10 flex items-center justify-between pointer-events-none select-none"
  aria-label="Primary Navigation"
>
  <!-- Subtle glassmorphic top header backdrop -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#030712]/95 via-[#030712]/70 to-transparent backdrop-blur-[8px] border-b border-white/[0.06] pointer-events-none"
  >
  </div>

  <!-- Left: Glowing blue status dot + GOOGLE DEVELOPER EXPERT + Hairline Rule -->
  <div class="relative z-10 flex items-center gap-3 pointer-events-auto">
    <a
      href="#top"
      data-action="reset-atlas"
      class="group flex items-center gap-3 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#38BDF8] rounded-md"
      aria-label="Ahmed Enes Turan — Google Developer Expert (Reset Atlas View)"
    >
      <span class="relative flex h-2.5 w-2.5">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38BDF8] opacity-75"
        ></span>
        <span
          class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#38BDF8] shadow-[0_0_12px_#38BDF8]"
        ></span>
      </span>
      <span
        class="font-mono text-[11px] sm:text-xs font-semibold tracking-[0.22em] uppercase text-slate-200 group-hover:text-white transition-colors"
      >
        GOOGLE DEVELOPER EXPERT
      </span>
    </a>
    <div
      class="hidden xl:block w-24 h-[1px] bg-gradient-to-r from-white/25 to-transparent ml-2"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Center: Navigation Links matching the Reference Image -->
  <nav
    class="relative z-10 hidden md:flex items-center gap-7 pointer-events-auto"
    aria-label="Site Sections"
  >
    <button
      type="button"
      data-action="reset-atlas"
      data-nav-link="home"
      class="relative py-1 text-xs font-medium tracking-[0.18em] uppercase text-white transition-colors cursor-pointer after:content-[''] after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-[2px] after:bg-[#38BDF8] after:shadow-[0_0_8px_#38BDF8]"
    >
      HOME
    </button>
    <button
      type="button"
      data-action="open-archive"
      data-testid="nav-talks-btn"
      class="py-1 text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      TALKS ({totalTalks})
    </button>
    <button
      type="button"
      data-action="focus-globe"
      class="py-1 text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      MAP
    </button>
    <button
      type="button"
      data-action="open-about"
      data-testid="nav-about-btn"
      class="py-1 text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      ABOUT
    </button>
    <a
      href="https://medium.com/@devenes"
      target="_blank"
      rel="noopener noreferrer"
      class="py-1 text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors"
    >
      BLOG
    </a>
    <a
      href="https://speakerdeck.com/devenes"
      target="_blank"
      rel="noopener noreferrer"
      class="py-1 text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors"
    >
      RESOURCES
    </a>
  </nav>

  <!-- Right: Mobile Archive Button & GET IN TOUCH CTA Pill -->
  <div class="relative z-10 flex items-center gap-3 pointer-events-auto">
    <button
      type="button"
      data-action="open-archive"
      class="md:hidden rounded-full px-3 py-1.5 text-[11px] font-mono uppercase tracking-wider text-slate-200 bg-white/[0.06] border border-white/15"
    >
      TALKS ({totalTalks})
    </button>
    <a
      href="https://www.linkedin.com/in/devenes/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-[11px] font-semibold tracking-[0.16em] uppercase text-slate-100 bg-white/[0.04] hover:bg-[#38BDF8]/15 border border-white/20 hover:border-[#38BDF8]/60 transition-all shadow-[0_0_20px_rgba(56,189,248,0.1)]"
    >
      <span>GET IN TOUCH</span>
      <span aria-hidden="true" class="text-[#38BDF8]">↗</span>
    </a>
  </div>
</header>
