---
import type { OrbitArchive } from '../schemas/talkSchema';
import type { OrbitTelemetry } from '../utils/metrics';

interface Props {
  speaker: OrbitArchive['speaker'];
  telemetry: OrbitTelemetry;
}

const { speaker } = Astro.props;
---

<header
  class="fixed top-0 inset-x-0 z-30 h-20 px-6 md:px-12 flex items-center justify-between pointer-events-none select-none"
  aria-label="Primary Navigation"
>
  <!-- Subtle top glassmorphic gradient bar -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#050811]/90 via-[#050811]/55 to-transparent backdrop-blur-[6px] border-b border-white/[0.06] pointer-events-none"
  >
  </div>

  <!-- Left: Status dot + GOOGLE DEVELOPER EXPERT + Hairline Rule -->
  <div class="relative z-10 flex items-center gap-3.5 pointer-events-auto">
    <a
      href="#top"
      data-action="reset-overview"
      class="group flex items-center gap-3 text-left focus:outline-none"
      aria-label={`${speaker.name} — ${speaker.role}`}
    >
      <span class="relative flex h-2.5 w-2.5">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#38BDF8] opacity-75"
        ></span>
        <span
          class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#38BDF8] shadow-[0_0_12px_#38BDF8]"
        ></span>
      </span>
      <span
        class="font-mono text-[11px] sm:text-xs font-semibold tracking-[0.24em] uppercase text-slate-200 group-hover:text-white transition-colors"
      >
        {speaker.role}
      </span>
    </a>
    <div
      class="hidden lg:block w-24 xl:w-40 h-[1px] bg-gradient-to-r from-white/20 to-transparent ml-2"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Right: Navigation Links & CTA Pill -->
  <nav class="relative z-10 flex items-center gap-5 md:gap-8 pointer-events-auto" aria-label="Site Sections">
    <button
      type="button"
      data-action="open-archive"
      data-testid="nav-talks-btn"
      class="text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      TALKS
    </button>
    <button
      type="button"
      data-action="open-about"
      data-testid="nav-about-btn"
      class="text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      ABOUT
    </button>
    <a
      href="https://medium.com/@devenes"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden sm:inline-block text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors"
    >
      BLOG
    </a>
    <button
      type="button"
      data-action="open-archive-slides"
      class="hidden md:inline-block text-xs font-medium tracking-[0.18em] uppercase text-slate-300 hover:text-white transition-colors cursor-pointer"
    >
      RESOURCES
    </button>
    <a
      href="https://www.linkedin.com/in/devenes/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-[11px] font-semibold tracking-[0.16em] uppercase text-slate-100 bg-white/[0.04] hover:bg-[#38BDF8]/15 border border-white/20 hover:border-[#38BDF8]/60 transition-all shadow-[0_0_20px_rgba(56,189,248,0.08)]"
    >
      <span>GET IN TOUCH</span>
      <span aria-hidden="true" class="text-[#38BDF8]">↗</span>
    </a>
  </nav>
</header>
