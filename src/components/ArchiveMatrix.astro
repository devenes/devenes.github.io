---
import type { SpeakingAtlasData } from '../utils/geography';
import { formatSignalDate } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { events, cities, topics, years, metrics } = atlas;
---

<div
  id="archive-matrix-modal"
  data-testid="archive-matrix-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="archive-matrix-title"
  class="fixed inset-0 z-50 hidden flex-col bg-[#030712]/92 backdrop-blur-2xl overflow-hidden"
>
  <!-- Modal Header -->
  <div class="px-6 md:px-12 py-5 border-b border-white/10 flex flex-wrap items-center justify-between gap-4 bg-slate-950/70">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="h-2 w-2 rounded-full bg-[#38BDF8] shadow-[0_0_8px_#38BDF8]"></span>
        <span class="font-mono text-[10px] tracking-[0.24em] uppercase text-[#38BDF8]">
          COMPLETE CHRONOLOGICAL SPEAKING ARCHIVE
        </span>
      </div>
      <h2
        id="archive-matrix-title"
        class="mt-1 font-display text-2xl sm:text-3xl font-bold text-white tracking-tight"
      >
        All Speaking Engagements ({metrics.totalTalks})
      </h2>
    </div>

    <div class="flex items-center gap-4">
      <p
        id="archive-result-counter"
        data-testid="archive-result-counter"
        class="font-mono text-xs text-slate-300"
      >
        Showing {events.length} of {events.length} talks ({metrics.uniqueCities} physical cities across{' '}
        {metrics.uniqueCountries} countries + {metrics.onlineTalks} online)
      </p>

      <button
        type="button"
        data-action="close-archive"
        data-testid="close-archive-btn"
        aria-label="Close Archive Matrix"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] hover:bg-white/[0.15] border border-white/15 text-slate-200 hover:text-white transition-colors cursor-pointer text-xl leading-none"
      >
        ×
      </button>
    </div>
  </div>

  <!-- Search & Multi-Facet Filter Bar -->
  <div class="px-6 md:px-12 py-4 border-b border-white/10 bg-slate-900/50 flex flex-col gap-3">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
      <!-- Instant Search Input -->
      <div class="md:col-span-4 relative">
        <label for="archive-search-input" class="sr-only">
          Search talks by title, event, city, country, or topic
        </label>
        <input
          id="archive-search-input"
          data-testid="archive-search-input"
          type="search"
          placeholder="Search by title, event, city, country, or topic..."
          autocomplete="off"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none transition-colors"
        />
      </div>

      <!-- Technical Domain Dropdown -->
      <div class="md:col-span-3">
        <label for="archive-cluster-select" class="sr-only">Technical Domain</label>
        <select
          id="archive-cluster-select"
          data-testid="archive-cluster-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Technical Domains</option>
          {
            topics.map((t) => (
              <option value={t.id}>
                {t.label} ({t.talksCount})
              </option>
            ))
          }
        </select>
      </div>

      <!-- Session Type Dropdown -->
      <div class="md:col-span-2">
        <label for="archive-type-select" class="sr-only">Session Format</label>
        <select
          id="archive-type-select"
          data-testid="archive-type-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Session Formats</option>
          <option value="keynote">Keynote ({metrics.keynotesCount})</option>
          <option value="conference">Conference ({metrics.conferencesCount})</option>
          <option value="workshop">Workshop ({metrics.workshopsCount})</option>
        </select>
      </div>

      <!-- Year Dropdown -->
      <div class="md:col-span-1">
        <label for="archive-year-select" class="sr-only">Year</label>
        <select
          id="archive-year-select"
          data-testid="archive-year-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Years</option>
          {
            years.map((y) => (
              <option value={y.year}>
                {y.year} ({y.talksCount})
              </option>
            ))
          }
        </select>
      </div>

      <!-- City / Destination Dropdown -->
      <div class="md:col-span-2">
        <label for="archive-city-select" class="sr-only">Destination City</label>
        <select
          id="archive-city-select"
          data-testid="archive-city-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Destinations ({metrics.uniqueCities} + Online)</option>
          {
            cities.map((c) => (
              <option value={c.id}>
                {c.city}, {c.country} ({c.eventsCount})
              </option>
            ))
          }
          <option value="online">Online ({metrics.onlineTalks})</option>
        </select>
      </div>
    </div>

    <!-- Quick Filter Pill Row for Session Formats -->
    <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Session Type Quick Filters">
        <span class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mr-1">
          Format:
        </span>
        {
          (['all', 'keynote', 'conference', 'workshop'] as const).map((typeKey) => (
            <button
              type="button"
              data-archive-type={typeKey}
              data-testid={`archive-type-btn-${typeKey}`}
              class={`rounded-lg px-2.5 py-1 font-mono text-[11px] uppercase transition-colors cursor-pointer border ${
                typeKey === 'all'
                  ? 'bg-[#38BDF8]/20 text-white border-[#38BDF8]/50'
                  : 'bg-white/[0.04] text-slate-300 border-white/10 hover:bg-white/10'
              }`}
            >
              {typeKey}
            </button>
          ))
        }
      </div>

      <button
        type="button"
        id="archive-reset-filters-btn"
        data-testid="archive-reset-filters-btn"
        class="font-mono text-[11px] text-slate-400 hover:text-[#38BDF8] transition-colors cursor-pointer"
      >
        Reset Filters ↺
      </button>
    </div>
  </div>

  <!-- Scrollable Table Container -->
  <div class="flex-1 overflow-y-auto px-6 md:px-12 py-6">
    <div class="max-w-7xl mx-auto overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/70">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/10 font-mono text-[10px] tracking-[0.2em] uppercase text-slate-400 bg-slate-900/60">
            <th class="py-3.5 px-4">Date</th>
            <th class="py-3.5 px-4">Event</th>
            <th class="py-3.5 px-4">Talk Title</th>
            <th class="py-3.5 px-4">Destination</th>
            <th class="py-3.5 px-4">Topics</th>
            <th class="py-3.5 px-4 text-right">Format</th>
          </tr>
        </thead>
        <tbody id="archive-rows-container" class="divide-y divide-white/[0.06] text-sm">
          {
            events.map((ev) => {
              const searchBlob = [
                ev.talk,
                ev.event,
                ev.city,
                ev.cityName,
                ev.countryName,
                ev.description,
                ev.sessionType,
                ...ev.topics,
              ]
                .join(' ')
                .toLowerCase();

              return (
                <tr
                  data-archive-row
                  data-testid="archive-row"
                  data-event-id={ev.id}
                  data-city-id={ev.isOnline ? 'online' : (ev.locationId ?? '')}
                  data-type={ev.sessionType}
                  data-clusters={ev.topicCategories.join(',')}
                  data-year={ev.year}
                  data-country={ev.countryCode}
                  data-search={searchBlob}
                  tabindex="0"
                  role="button"
                  aria-label={`${ev.talk} at ${ev.event} (${ev.city})`}
                  class="group hover:bg-white/[0.05] transition-colors cursor-pointer"
                >
                  <td class="py-3.5 px-4 font-mono text-xs text-slate-400 whitespace-nowrap">
                    {formatSignalDate(ev.date)}
                  </td>
                  <td class="py-3.5 px-4 font-semibold text-white group-hover:text-[#38BDF8] transition-colors max-w-xs">
                    {ev.event}
                  </td>
                  <td class="py-3.5 px-4 text-slate-200 max-w-md">{ev.talk}</td>
                  <td class="py-3.5 px-4 text-xs text-slate-300 whitespace-nowrap">
                    {ev.flag} {ev.city}
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex flex-wrap gap-1">
                      {ev.topics.slice(0, 3).map((topic) => (
                        <span class="rounded-full px-2 py-0.5 font-mono text-[10px] bg-white/[0.06] text-slate-300 border border-white/10">
                          {topic}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <span
                      data-testid="archive-row-type"
                      class="inline-block rounded-md px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider bg-white/[0.06] text-slate-200 border border-white/15"
                    >
                      {ev.sessionType}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>

      <div
        id="archive-empty-state"
        class="hidden py-12 text-center font-mono text-sm text-slate-400"
      >
        No speaking engagements match the active search or filter criteria.
      </div>
    </div>
  </div>
</div>
