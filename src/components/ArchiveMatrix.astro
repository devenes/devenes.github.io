---
import type { SpeakingAtlasData } from '../utils/geography';
import { formatSignalDate } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { events, cities, topics, years, metrics } = atlas;
---

<dialog
  id="archive-matrix-modal"
  data-testid="archive-matrix-modal"
  closedby="any"
  aria-hidden="true"
  aria-labelledby="archive-matrix-title"
  class="fixed inset-0 m-0 h-full w-full max-h-none max-w-none flex-col bg-[#0B0C0E]/96 text-[#F4F1EA] backdrop-blur-xl overflow-hidden p-0"
>
  <!-- Header -->
  <div class="px-6 md:px-12 py-5 border-b border-[#F4F1EA]/12 flex flex-wrap items-center justify-between gap-4 bg-[#121417]">
    <div>
      <p class="text-xs font-medium text-[#E2A84B]">Speaking archive · 2023–2026</p>
      <h2
        id="archive-matrix-title"
        class="mt-0.5 font-display text-2xl sm:text-3xl font-medium text-[#F4F1EA]"
      >
        All talks &amp; workshops ({metrics.totalTalks})
      </h2>
    </div>

    <div class="flex items-center gap-4">
      <p
        id="archive-result-counter"
        data-testid="archive-result-counter"
        aria-live="polite"
        class="text-xs text-[#C6C2B8] tabular-nums"
      >
        Showing {events.length} of {events.length} talks ({metrics.uniqueCities} cities across{' '}
        {metrics.uniqueCountries} countries + {metrics.onlineTalks} online)
      </p>

      <button
        type="button"
        data-action="close-archive"
        data-testid="close-archive-btn"
        aria-label="Close talks archive"
        class="flex min-h-[2.25rem] min-w-[2.25rem] items-center justify-center rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-lg leading-none"
      >
        ×
      </button>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="px-6 md:px-12 py-4 border-b border-[#F4F1EA]/12 bg-[#121417]/75 flex flex-col gap-3">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
      <div class="md:col-span-4 relative">
        <label for="archive-search-input" class="sr-only">
          Search talks by title, event, city, country, or topic
        </label>
        <input
          id="archive-search-input"
          data-testid="archive-search-input"
          type="search"
          placeholder="Search title, conference, city, or topic..."
          autocomplete="off"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] pl-3.5 pr-14 py-2 text-sm text-[#F4F1EA] placeholder-[#6E6A61] focus:outline-none transition-colors"
        />
        <kbd
          aria-hidden="true"
          class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 hidden sm:inline-flex items-center rounded border border-[#F4F1EA]/15 bg-[#181B20] px-1.5 py-0.5 font-mono text-[0.6875rem] text-[#9C978C]"
        >
          ⌘K
        </kbd>
      </div>

      <div class="md:col-span-3">
        <label for="archive-cluster-select" class="sr-only">Topic</label>
        <select
          id="archive-cluster-select"
          data-testid="archive-cluster-select"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] px-3 py-2 text-xs text-[#F4F1EA] focus:outline-none"
        >
          <option value="all">All topics</option>
          {
            topics.map((t) => (
              <option value={t.id}>
                {t.label} ({t.talksCount})
              </option>
            ))
          }
        </select>
      </div>

      <div class="md:col-span-2">
        <label for="archive-type-select" class="sr-only">Format</label>
        <select
          id="archive-type-select"
          data-testid="archive-type-select"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] px-3 py-2 text-xs text-[#F4F1EA] focus:outline-none"
        >
          <option value="all">All formats</option>
          <option value="keynote">Keynote ({metrics.keynotesCount})</option>
          <option value="conference">Conference ({metrics.conferencesCount})</option>
          <option value="workshop">Workshop ({metrics.workshopsCount})</option>
        </select>
      </div>

      <div class="md:col-span-1">
        <label for="archive-year-select" class="sr-only">Year</label>
        <select
          id="archive-year-select"
          data-testid="archive-year-select"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] px-3 py-2 text-xs text-[#F4F1EA] focus:outline-none"
        >
          <option value="all">All years</option>
          {
            years.map((y) => (
              <option value={y.year}>
                {y.year} ({y.talksCount})
              </option>
            ))
          }
        </select>
      </div>

      <div class="md:col-span-2">
        <label for="archive-city-select" class="sr-only">City</label>
        <select
          id="archive-city-select"
          data-testid="archive-city-select"
          class="w-full rounded-lg bg-[#0B0C0E] border border-[#F4F1EA]/20 focus:border-[#E2A84B] px-3 py-2 text-xs text-[#F4F1EA] focus:outline-none"
        >
          <option value="all">All cities ({metrics.uniqueCities} + Online)</option>
          {
            cities.map((c) => (
              <option value={c.id}>
                {c.city}, {c.country} ({c.eventsCount})
              </option>
            ))
          }
          <option value="online">Online ({metrics.onlineTalks})</option>
        </select>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 pt-0.5">
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by session format">
        <span class="text-xs text-[#9C978C] mr-1">Format:</span>
        {
          (['all', 'keynote', 'conference', 'workshop'] as const).map((typeKey) => (
            <button
              type="button"
              data-archive-type={typeKey}
              data-testid={`archive-type-btn-${typeKey}`}
              aria-pressed={typeKey === 'all' ? 'true' : 'false'}
              class="filter-pill rounded-md px-2.5 py-1 text-xs capitalize transition-colors cursor-pointer border"
            >
              {typeKey}
            </button>
          ))
        }
      </div>

      <button
        type="button"
        id="archive-reset-filters-btn"
        data-testid="archive-reset-filters-btn"
        class="text-xs text-[#9C978C] hover:text-[#E2A84B] transition-colors cursor-pointer"
      >
        Reset filters
      </button>
    </div>
  </div>

  <!-- Table -->
  <div class="flex-1 overflow-y-auto px-6 md:px-12 py-6">
    <div class="max-w-7xl mx-auto overflow-x-auto rounded-xl border border-[#F4F1EA]/12 bg-[#121417]">
      <table class="w-full text-left border-collapse">
        <caption class="sr-only">
          Chronological list of all {metrics.totalTalks} speaking engagements by Enes Turan
        </caption>
        <thead>
          <tr class="border-b border-[#F4F1EA]/12 text-xs font-medium text-[#9C978C] bg-[#181B20]/70">
            <th scope="col" class="py-3 px-4">Date</th>
            <th scope="col" class="py-3 px-4">Talk</th>
            <th scope="col" class="py-3 px-4">Event</th>
            <th scope="col" class="py-3 px-4">Location</th>
            <th scope="col" class="py-3 px-4">Topics</th>
            <th scope="col" class="py-3 px-4 text-right">Format</th>
          </tr>
        </thead>
        <tbody id="archive-rows-container" class="divide-y divide-[#F4F1EA]/[0.07] text-sm">
          {
            events.map((ev) => {
              const searchBlob = [
                ev.talk,
                ev.event,
                ev.city,
                ev.cityName,
                ev.countryName,
                ev.description,
                ev.sessionType,
                ...ev.topics,
              ]
                .join(' ')
                .toLowerCase();

              return (
                <tr
                  data-archive-row
                  data-testid="archive-row"
                  data-event-id={ev.id}
                  data-city-id={ev.isOnline ? 'online' : (ev.locationId ?? '')}
                  data-type={ev.sessionType}
                  data-clusters={ev.topicCategories.join(',')}
                  data-year={ev.year}
                  data-country={ev.countryCode}
                  data-search={searchBlob}
                  tabindex="0"
                  role="button"
                  aria-label={`${ev.talk} at ${ev.event} (${ev.city})`}
                  class="group hover:bg-[#181B20] transition-colors cursor-pointer"
                >
                  <td class="py-3.5 px-4 font-mono text-xs text-[#9C978C] whitespace-nowrap">
                    {formatSignalDate(ev.date)}
                  </td>
                  <td class="py-3.5 px-4 font-medium text-[#F4F1EA] group-hover:text-white max-w-md">
                    {ev.talk}
                  </td>
                  <td class="py-3.5 px-4 text-xs text-[#C6C2B8] max-w-xs">
                    {ev.event}
                  </td>
                  <td class="py-3.5 px-4 text-xs text-[#C6C2B8] whitespace-nowrap">
                    {ev.city}
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex flex-wrap gap-1">
                      {ev.topics.slice(0, 3).map((topic) => (
                        <span class="rounded px-2 py-0.5 text-xs bg-[#181B20] text-[#9C978C] border border-[#F4F1EA]/10">
                          {topic}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <span
                      data-testid="archive-row-type"
                      class={`inline-block rounded px-2 py-0.5 text-xs capitalize border ${
                        ev.sessionType === 'keynote' || ev.sessionType === 'workshop'
                          ? 'bg-[#E2A84B]/12 text-[#F3D08A] border-[#E2A84B]/35'
                          : 'bg-[#181B20] text-[#C6C2B8] border-[#F4F1EA]/12'
                      }`}
                    >
                      {ev.sessionType}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>

      <div
        id="archive-empty-state"
        class="hidden py-12 text-center text-sm text-[#9C978C]"
      >
        No talks match the current search or filter selection.
      </div>
    </div>
  </div>
</dialog>
