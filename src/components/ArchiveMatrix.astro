---
import type { Cluster, Talk } from '../schemas/talkSchema';
import type { OrbitTelemetry } from '../utils/metrics';
import { formatSignalDate } from '../utils/paths';

interface Props {
  talks: Talk[];
  clusters: Cluster[];
  telemetry: OrbitTelemetry;
}

const { talks, clusters, telemetry } = Astro.props;

const clusterBadgeStyles: Record<string, string> = {
  ai: 'bg-[#38BDF8]/15 text-[#38BDF8] border-[#38BDF8]/35',
  k8s: 'bg-[#F59E0B]/15 text-[#FBBF24] border-[#F59E0B]/35',
  cloud: 'bg-[#FACC15]/15 text-[#FACC15] border-[#FACC15]/35',
  workshops: 'bg-[#10B981]/15 text-[#34D399] border-[#10B981]/35',
};

const clusterLabels: Record<string, string> = {
  ai: 'AI Agents',
  k8s: 'Kubernetes',
  cloud: 'Google Cloud',
  workshops: 'Workshops',
};
---

<div
  id="archive-matrix-modal"
  data-testid="archive-matrix-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="archive-matrix-title"
  class="fixed inset-0 z-50 hidden flex-col bg-[#050811]/90 backdrop-blur-2xl overflow-hidden"
>
  <!-- Modal Header -->
  <div class="px-6 md:px-12 py-5 border-b border-white/10 flex flex-wrap items-center justify-between gap-4 bg-slate-950/60">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="h-2 w-2 rounded-full bg-[#38BDF8] shadow-[0_0_8px_#38BDF8]"></span>
        <span class="font-mono text-[10px] tracking-[0.24em] uppercase text-[#38BDF8]">
          ORBIT TELEMETRY ARCHIVE
        </span>
      </div>
      <h2
        id="archive-matrix-title"
        class="mt-1 font-display text-2xl sm:text-3xl font-bold text-white tracking-tight"
      >
        Global Speaking Matrix
      </h2>
    </div>

    <div class="flex items-center gap-4">
      <p
        id="archive-result-counter"
        data-testid="archive-result-counter"
        class="font-mono text-xs text-slate-300"
      >
        Showing {talks.length} of {talks.length} talks across {telemetry.uniqueCountries} countries
      </p>

      <button
        type="button"
        data-action="close-archive"
        data-testid="close-archive-btn"
        aria-label="Close Archive Matrix"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] hover:bg-white/[0.15] border border-white/15 text-slate-200 hover:text-white transition-colors cursor-pointer text-xl leading-none"
      >
        ×
      </button>
    </div>
  </div>

  <!-- Search & Multi-Facet Filter Bar -->
  <div class="px-6 md:px-12 py-4 border-b border-white/10 bg-slate-900/45 flex flex-col gap-3">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
      <!-- Instant Search Input -->
      <div class="md:col-span-5 relative">
        <label for="archive-search-input" class="sr-only">
          Search talks by title, event, city, country, or topics
        </label>
        <input
          id="archive-search-input"
          data-testid="archive-search-input"
          type="search"
          placeholder="Search by title, event, city, country, or topic..."
          autocomplete="off"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none transition-colors"
        />
      </div>

      <!-- Topic Cluster Dropdown -->
      <div class="md:col-span-2">
        <label for="archive-cluster-select" class="sr-only">Topic Cluster</label>
        <select
          id="archive-cluster-select"
          data-testid="archive-cluster-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Clusters</option>
          {
            clusters.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))
          }
        </select>
      </div>

      <!-- Session Type Dropdown -->
      <div class="md:col-span-2">
        <label for="archive-type-select" class="sr-only">Session Type</label>
        <select
          id="archive-type-select"
          data-testid="archive-type-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Session Types</option>
          <option value="keynote">Keynote</option>
          <option value="conference">Conference</option>
          <option value="workshop">Workshop</option>
        </select>
      </div>

      <!-- Year Dropdown -->
      <div class="md:col-span-1">
        <label for="archive-year-select" class="sr-only">Year</label>
        <select
          id="archive-year-select"
          data-testid="archive-year-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Years</option>
          {
            telemetry.years.map((y) => (
              <option value={y}>{y}</option>
            ))
          }
        </select>
      </div>

      <!-- Country Dropdown -->
      <div class="md:col-span-2">
        <label for="archive-country-select" class="sr-only">Country</label>
        <select
          id="archive-country-select"
          data-testid="archive-country-select"
          class="w-full rounded-xl bg-slate-950/90 border border-white/15 focus:border-[#38BDF8] px-3 py-2.5 text-xs text-slate-200 focus:outline-none"
        >
          <option value="all">All Countries</option>
          {
            telemetry.countries.map((c) => (
              <option value={c.code}>{c.name}</option>
            ))
          }
        </select>
      </div>
    </div>

    <!-- Quick Filter Pill Row for Session Types & Clusters -->
    <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
      <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Session Type Quick Filters">
        <span class="font-mono text-[10px] tracking-widest uppercase text-slate-400 mr-1">
          Format:
        </span>
        {
          (['all', 'keynote', 'conference', 'workshop'] as const).map((typeKey) => (
            <button
              type="button"
              data-archive-type={typeKey}
              data-testid={`archive-type-btn-${typeKey}`}
              class={`rounded-lg px-2.5 py-1 font-mono text-[11px] uppercase transition-colors cursor-pointer border ${
                typeKey === 'all'
                  ? 'bg-[#38BDF8]/20 text-white border-[#38BDF8]/50'
                  : 'bg-white/[0.04] text-slate-300 border-white/10 hover:bg-white/10'
              }`}
            >
              {typeKey}
            </button>
          ))
        }
      </div>

      <button
        type="button"
        id="archive-reset-filters-btn"
        data-testid="archive-reset-filters-btn"
        class="font-mono text-[11px] text-slate-400 hover:text-[#38BDF8] transition-colors cursor-pointer"
      >
        Reset Filters ↺
      </button>
    </div>
  </div>

  <!-- Scrollable Table Container -->
  <div class="flex-1 overflow-y-auto px-6 md:px-12 py-6">
    <div class="max-w-7xl mx-auto overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/65">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/10 font-mono text-[10px] tracking-[0.2em] uppercase text-slate-400 bg-slate-900/60">
            <th class="py-3.5 px-4">Date</th>
            <th class="py-3.5 px-4">Event</th>
            <th class="py-3.5 px-4">Talk Title</th>
            <th class="py-3.5 px-4">Location</th>
            <th class="py-3.5 px-4">Clusters</th>
            <th class="py-3.5 px-4 text-right">Type</th>
          </tr>
        </thead>
        <tbody id="archive-rows-container" class="divide-y divide-white/[0.06] text-sm">
          {
            talks.map((talk) => {
              const allClusters = Array.from(new Set([talk.primaryCluster, ...talk.topics]));
              const searchBlob = [
                talk.title,
                talk.event,
                talk.city,
                talk.country,
                talk.countryCode,
                talk.type,
                ...allClusters.map((c) => clusterLabels[c] ?? c),
              ]
                .join(' ')
                .toLowerCase();

              return (
                <tr
                  data-archive-row
                  data-testid="archive-row"
                  data-talk-id={talk.id}
                  data-type={talk.type}
                  data-clusters={allClusters.join(',')}
                  data-year={talk.date.slice(0, 4)}
                  data-country={talk.countryCode.toUpperCase()}
                  data-search={searchBlob}
                  tabindex="0"
                  role="button"
                  aria-label={`${talk.title} at ${talk.event}`}
                  class="group hover:bg-white/[0.05] transition-colors cursor-pointer"
                >
                  <td class="py-3.5 px-4 font-mono text-xs text-slate-400 whitespace-nowrap">
                    {formatSignalDate(talk.date)}
                  </td>
                  <td class="py-3.5 px-4 font-semibold text-white whitespace-nowrap group-hover:text-[#38BDF8] transition-colors">
                    {talk.event}
                  </td>
                  <td class="py-3.5 px-4 text-slate-200 max-w-md">
                    {talk.title}
                  </td>
                  <td class="py-3.5 px-4 text-xs text-slate-300 whitespace-nowrap">
                    📍 {talk.city}, {talk.country}
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex flex-wrap gap-1">
                      {allClusters.map((cid) => (
                        <span
                          class={`rounded-full px-2 py-0.5 font-mono text-[10px] border ${
                            clusterBadgeStyles[cid] ?? 'bg-white/10 text-slate-200 border-white/20'
                          }`}
                        >
                          {clusterLabels[cid] ?? cid}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <span
                      data-testid="archive-row-type"
                      class="inline-block rounded-md px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider bg-white/[0.06] text-slate-200 border border-white/15"
                    >
                      {talk.type}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>

      <!-- Empty State -->
      <div
        id="archive-empty-state"
        class="hidden py-12 text-center font-mono text-sm text-slate-400"
      >
        No matching speaking signals found for the current filters.
      </div>
    </div>
  </div>
</div>
