---
import type { SpeakingAtlasData } from '../utils/geography';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { metrics } = atlas;
---

<dialog
  id="about-modal"
  data-testid="about-modal"
  closedby="any"
  aria-hidden="true"
  aria-labelledby="about-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-xl bg-[#121417] text-[#F4F1EA] border border-[#F4F1EA]/16 p-6 sm:p-8 shadow-2xl overflow-y-auto max-h-[90vh]"
>
  <div class="flex items-center justify-between pb-4 border-b border-[#F4F1EA]/12">
    <span class="text-xs font-medium text-[#9C978C]">About</span>
    <button
      type="button"
      data-action="close-about"
      data-testid="close-about-btn"
      aria-label="Close speaker bio"
      class="flex min-h-[2rem] min-w-[2rem] items-center justify-center rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-base leading-none"
    >
      ×
    </button>
  </div>

  <div class="mt-5">
    <h2 id="about-modal-title" class="font-display text-3xl sm:text-4xl font-medium text-[#F4F1EA]">
      Enes Turan
    </h2>
    <p class="mt-1 text-xs sm:text-sm text-[#E2A84B]">
      Google Developer Expert — Cloud, Kubernetes &amp; AI · Based in Istanbul
    </p>

    <div class="mt-4 space-y-3 max-w-[60ch] text-sm text-[#C6C2B8] leading-[1.6]">
      <p>
        I'm a cloud and platform engineer in Istanbul. Most of my day-to-day work focuses on
        running production Kubernetes clusters, Google Cloud infrastructure, and multi-agent AI
        systems that hold up outside a demo.
      </p>
      <p>
        Since 2023, I've given {metrics.totalTalks} talks, keynotes, and hands-on workshops across{' '}
        {metrics.uniqueCities} cities in {metrics.uniqueCountries} countries—from community
        DevFests across Anatolia, Central Asia, and the Balkans to clinical AI workshops and
        reliability engineering summits.
      </p>
    </div>

    <div class="mt-6 rounded-lg bg-[#181B20]/80 border border-[#F4F1EA]/12 p-4 space-y-2 text-xs">
      <div class="font-semibold text-[#F4F1EA]">For event &amp; workshop organizers</div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-[#C6C2B8]">
        <div>
          <span class="block text-[#9C978C]">Current topics</span>
          <span class="mt-0.5 block text-[#F4F1EA]">Agentic AI (ADK, Vertex AI), GKE &amp; SRE</span>
        </div>
        <div>
          <span class="block text-[#9C978C]">Formats</span>
          <span class="mt-0.5 block text-[#F4F1EA]">Keynotes, 40m deep dives, hands-on labs</span>
        </div>
        <div>
          <span class="block text-[#9C978C]">Home airport</span>
          <span class="mt-0.5 block font-mono text-[#F4F1EA]">Istanbul (IST / SAW)</span>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2.5">
      <a
        href="https://www.linkedin.com/in/devenes/"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-[#F4F1EA] hover:bg-white px-4 py-2 text-xs font-semibold text-[#0B0C0E] transition-colors"
      >
        LinkedIn ↗
      </a>
      <a
        href="https://github.com/devenes"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 px-4 py-2 text-xs font-medium text-[#E6E2D8] transition-colors"
      >
        GitHub (@devenes) ↗
      </a>
      <a
        href="https://medium.com/@devenes"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 px-4 py-2 text-xs font-medium text-[#E6E2D8] transition-colors"
      >
        Medium ↗
      </a>
      <a
        href="https://speakerdeck.com/devenes"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 px-4 py-2 text-xs font-medium text-[#E6E2D8] transition-colors"
      >
        Speaker Deck ↗
      </a>
    </div>
  </div>
</dialog>
