---
import CopyButton from './CopyButton.astro';
import { SPEAKER_PROFILE } from '../data/speakerProfile';
import type { SpeakingAtlasData } from '../utils/geography';
import { withBase } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { metrics } = atlas;
const primaryPhoto = SPEAKER_PROFILE.headshots[0];
---

<dialog
  id="about-modal"
  data-testid="about-modal"
  closedby="any"
  aria-hidden="true"
  aria-labelledby="about-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-xl bg-[#121417] text-[#F4F1EA] border border-[#F4F1EA]/16 p-6 sm:p-8 shadow-2xl overflow-y-auto max-h-[90vh]"
>
  <div class="flex items-center justify-between pb-4 border-b border-[#F4F1EA]/12">
    <span class="text-xs font-medium text-[#9C978C]">About</span>
    <button
      type="button"
      data-action="close-about"
      data-testid="close-about-btn"
      aria-label="Close speaker bio"
      class="flex min-h-[2rem] min-w-[2rem] items-center justify-center rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-base leading-none"
    >
      ×
    </button>
  </div>

  <div class="mt-5">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
      <img
        src={withBase(primaryPhoto.assetPath)}
        alt="Enes Turan"
        width="88"
        height="88"
        fetchpriority="low"
        loading="lazy"
        decoding="async"
        class="h-20 w-20 rounded-xl object-cover border border-[#F4F1EA]/16 shrink-0"
      />
      <div>
        <h2
          id="about-modal-title"
          class="font-display text-3xl sm:text-4xl font-medium text-[#F4F1EA]"
        >
          {SPEAKER_PROFILE.name}
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-[#E2A84B]">
          {SPEAKER_PROFILE.roleHeadline} · Based in Istanbul
        </p>
      </div>
    </div>

    <div class="mt-4 space-y-3 max-w-[60ch] text-sm text-[#C6C2B8] leading-[1.6]">
      <p>
        I'm a Software Engineer at JumpCloud and a cloud and platform engineer in Istanbul. Most of
        my day-to-day work focuses on Kubernetes, multi-cloud platform engineering, and running
        secure, scalable infrastructure for AI workloads.
      </p>
      <p>
        Since 2023, I've given {metrics.totalTalks} talks, keynotes, and hands-on workshops across{' '}
        {metrics.uniqueCities} cities in {metrics.uniqueCountries} countries—from community
        DevFests across Anatolia, Central Asia, and the Balkans to clinical AI workshops and
        reliability engineering summits.
      </p>
    </div>

    <!-- Third-Person Copyable Organizer Bio -->
    <div class="mt-5 rounded-lg bg-[#181B20]/80 border border-[#F4F1EA]/12 p-4 space-y-2.5 text-xs">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="font-semibold text-[#F4F1EA]">Third-person speaker bio (for organizers)</span>
        <CopyButton
          targetId="modal-organizer-bio"
          label="Copy bio"
          testId="modal-copy-bio-btn"
        />
      </div>
      <p id="modal-organizer-bio" class="text-xs leading-[1.6] text-[#C6C2B8]">
        {SPEAKER_PROFILE.standardBio}
      </p>
      <div class="pt-2 border-t border-[#F4F1EA]/10 flex flex-wrap items-center justify-between gap-2">
        <span class="text-[#9C978C]">
          Need high-res headshots or flagship talk abstracts?
        </span>
        <a
          href={withBase('speaker/')}
          data-testid="modal-speaker-kit-link"
          class="font-semibold text-[#E2A84B] hover:text-[#F4F1EA] transition-colors"
        >
          Open Speaker Kit &amp; Photos →
        </a>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      {
        SPEAKER_PROFILE.socialLinks.map((profile, idx) => (
          <a
            href={profile.url}
            target="_blank"
            rel="noopener noreferrer"
            class={
              idx === 0
                ? 'rounded-md bg-[#F4F1EA] hover:bg-white px-3.5 py-2 text-xs font-semibold text-[#0B0C0E] transition-colors'
                : 'rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 px-3.5 py-2 text-xs font-medium text-[#E6E2D8] transition-colors'
            }
          >
            {profile.platform} ↗
          </a>
        ))
      }
    </div>
  </div>
</dialog>
