---
import type { SpeakingAtlasData } from '../utils/geography';
import { withBase } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { metrics } = atlas;
---

<section
  id="hero-overview-panel"
  data-testid="hero-overview-panel"
  class="relative z-20 flex flex-col justify-center pointer-events-none select-none"
>
  <div
    class="pointer-events-auto relative rounded-2xl py-2 pr-4"
    style="background: radial-gradient(ellipse at 30% 50%, rgba(11, 12, 14, 0.84) 0%, rgba(11, 12, 14, 0.48) 68%, transparent 100%);"
  >
    <p class="text-xs font-medium text-[#E2A84B] tracking-wide mb-2">
      Istanbul · Cloud, Kubernetes &amp; AI
    </p>

    <h1
      class="font-display font-medium tracking-[-0.02em] leading-[1.06] text-[#F4F1EA]"
      style="font-size: clamp(2.35rem, 1.85rem + 1.8vw, 3.25rem);"
    >
      Enes Turan
    </h1>

    <p class="mt-3 max-w-[40ch] text-sm sm:text-[0.9375rem] leading-[1.55] text-[#C6C2B8]">
      Software Engineer at JumpCloud and Google Developer Expert sharing practical engineering
      talks and workshops on production Kubernetes, cloud infrastructure, and AI workloads.
    </p>

    <!-- Open Typographic Speaking Ledger -->
    <div class="mt-5 pt-4 border-t border-[#F4F1EA]/12 grid grid-cols-3 max-w-[340px] gap-4">
      <div>
        <div
          id="hero-talk-count"
          data-testid="metric-talks"
          data-physical={metrics.physicalTalks}
          data-online={metrics.onlineTalks}
          class="font-display text-3xl sm:text-[2.25rem] leading-[1.05] font-medium text-[#F4F1EA] tabular-nums"
        >
          {metrics.totalTalks}
        </div>
        <div class="mt-1 text-xs text-[#9C978C]">Talks</div>
      </div>

      <div class="pl-4 border-l border-[#F4F1EA]/12">
        <div
          data-testid="metric-countries"
          class="font-display text-3xl sm:text-[2.25rem] leading-[1.05] font-medium text-[#F4F1EA] tabular-nums"
        >
          {metrics.uniqueCountries}
        </div>
        <div class="mt-1 text-xs text-[#9C978C]">Countries</div>
      </div>

      <div class="pl-4 border-l border-[#F4F1EA]/12">
        <div
          data-testid="metric-cities"
          class="font-display text-3xl sm:text-[2.25rem] leading-[1.05] font-medium text-[#F4F1EA] tabular-nums"
        >
          {metrics.uniqueCities}
        </div>
        <div class="mt-1 text-xs text-[#9C978C]">Cities</div>
      </div>
    </div>

    <p class="mt-3 text-xs leading-[1.5] text-[#9C978C] tabular-nums">
      {metrics.physicalTalks} in-person sessions + {metrics.onlineTalks} online ·{' '}
      {metrics.keynotesCount} keynotes, {metrics.conferencesCount} conference talks,{' '}
      {metrics.workshopsCount} workshops
    </p>

    <!-- Restrained Editorial Actions -->
    <div class="mt-5 flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        data-action="open-archive"
        data-testid="browse-all-talks-btn"
        class="inline-flex items-center gap-2.5 rounded-md px-4 py-2.5 text-xs sm:text-sm font-semibold text-[#0B0C0E] bg-[#F4F1EA] hover:bg-white transition-colors cursor-pointer"
      >
        <span>Browse all talks</span>
        <kbd
          aria-hidden="true"
          class="hidden sm:inline-block rounded px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium text-[#0B0C0E]/80 bg-[#0B0C0E]/10 border border-[#0B0C0E]/15"
        >
          ⌘K
        </kbd>
      </button>

      <button
        type="button"
        data-action="explore-world"
        data-testid="explore-world-btn"
        class="inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-xs sm:text-sm font-medium text-[#F4F1EA] bg-[#121417]/85 hover:bg-[#181B20] border border-[#F4F1EA]/20 hover:border-[#F4F1EA]/35 transition-colors cursor-pointer"
      >
        <span>Istanbul hub</span>
        <span aria-hidden="true" class="text-[#E2A84B]">→</span>
      </button>

      <a
        href={withBase('speaker/')}
        data-testid="hero-speaker-kit-link"
        class="inline-flex items-center gap-1.5 rounded-md px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#E6E2D8] hover:text-[#F4F1EA] bg-[#121417]/88 hover:bg-[#181B20] border border-[#F4F1EA]/16 hover:border-[#F4F1EA]/32 backdrop-blur-sm transition-colors"
      >
        <span>Speaker kit &amp; bio</span>
        <span aria-hidden="true" class="text-[#E2A84B]">→</span>
      </a>
    </div>
  </div>
</section>
