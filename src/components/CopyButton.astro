---
interface Props {
  targetId: string;
  label?: string;
  ariaLabel?: string;
  testId?: string;
  variant?: 'primary' | 'subtle';
}

const {
  targetId,
  label = 'Copy',
  ariaLabel,
  testId,
  variant = 'subtle',
} = Astro.props;

const invokerAttrs = {
  command: '--copy',
  commandfor: targetId,
} as Record<string, string>;

const buttonClasses =
  variant === 'primary'
    ? 'copy-action-btn inline-flex min-h-[2rem] min-w-[2rem] items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-semibold text-[#0B0C0E] bg-[#F4F1EA] hover:bg-white transition-colors cursor-pointer whitespace-nowrap'
    : 'copy-action-btn inline-flex min-h-[2rem] min-w-[2rem] items-center gap-1.5 rounded-md px-2.5 py-1.5 text-xs font-medium text-[#E6E2D8] bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 hover:border-[#F4F1EA]/30 transition-colors cursor-pointer whitespace-nowrap';
---

<span class="copy-control-wrap relative inline-flex items-center gap-2">
  <button
    type="button"
    class={buttonClasses}
    data-testid={testId}
    aria-label={ariaLabel}
    {...invokerAttrs}
  >
    <svg
      class="copy-icon-idle h-3.5 w-3.5 shrink-0"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
      <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2"></path>
    </svg>
    <svg
      class="copy-icon-done hidden h-3.5 w-3.5 shrink-0 text-[#6BA38B]"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5l3.2 3.2L13 4.8"></path>
    </svg>
    <svg
      class="copy-icon-error hidden h-3.5 w-3.5 shrink-0 text-[#D4845A]"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path stroke-linecap="round" d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path>
    </svg>
    <span>{label}</span>
  </button>
  <span
    role="status"
    class="copy-live-bubble pointer-events-none rounded bg-[#22262D] border border-[#F4F1EA]/18 px-2 py-0.5 font-mono text-[0.6875rem] text-[#F4F1EA] opacity-0 transition-opacity duration-150 whitespace-nowrap"
  ></span>
</span>

<style is:global>
  .copy-action-btn[data-copied] .copy-icon-idle,
  .copy-action-btn[data-failed] .copy-icon-idle {
    display: none;
  }
  .copy-action-btn[data-copied] .copy-icon-done {
    display: block;
  }
  .copy-action-btn[data-failed] .copy-icon-error {
    display: block;
  }
  .copy-action-btn[data-copied] + .copy-live-bubble,
  .copy-action-btn[data-failed] + .copy-live-bubble {
    opacity: 1;
  }
</style>
