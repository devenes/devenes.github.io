---
import type { SpeakingAtlasData } from '../utils/geography';
import { formatSignalDate, withBase } from '../utils/paths';

interface Props {
  atlas: SpeakingAtlasData;
}

const { atlas } = Astro.props;
const { events, years, metrics } = atlas;
---

<section
  id="recent-signals-strip"
  data-testid="recent-signals-strip"
  class="relative z-20 px-5 lg:px-10 pb-5 pt-2 bg-gradient-to-t from-[#0B0C0E] via-[#0B0C0E]/92 to-transparent pointer-events-auto"
>
  <div class="max-w-[1560px] mx-auto">
    <!-- Top Row: Year Filter Pills & Full Archive Link -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-2.5">
      <div
        class="flex flex-wrap items-center gap-1.5 overflow-x-auto py-1"
        role="group"
        aria-label="Filter talks by year"
      >
        <button
          type="button"
          data-action="select-year"
          data-year="all"
          data-testid="timeline-year-all"
          aria-pressed="true"
          class="filter-pill year-filter-pill rounded-md px-3 py-1 font-mono text-xs border transition-colors cursor-pointer tabular-nums"
        >
          All ({metrics.totalTalks})
        </button>

        {
          [...years].reverse().map((y) => (
            <button
              type="button"
              data-action="select-year"
              data-year={y.year}
              data-testid={`timeline-year-${y.year}`}
              aria-pressed="false"
              class="filter-pill year-filter-pill rounded-md px-3 py-1 font-mono text-xs border transition-colors cursor-pointer tabular-nums"
            >
              {y.year} ({y.talksCount})
            </button>
          ))
        }

        <button
          type="button"
          id="active-topic-filter-pill"
          data-testid="active-topic-filter-pill"
          data-action="select-topic"
          data-topic="all"
          aria-label="Clear active topic filter"
          class="hidden items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-medium bg-[#E2A84B]/15 hover:bg-[#E2A84B]/25 text-[#F3D08A] border border-[#E2A84B]/55 transition-colors cursor-pointer"
        >
          <span id="active-topic-filter-label">Topic: AI</span>
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <!-- Right Controls: Scroll Arrows & Archive Trigger -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-1.5">
          <button
            type="button"
            id="timeline-scroll-prev"
            aria-label="Scroll talks left"
            aria-disabled="true"
            class="min-h-[1.75rem] min-w-[1.75rem] px-1.5 rounded-md flex items-center justify-center bg-[#121417] hover:bg-[#181B20] aria-disabled:opacity-35 aria-disabled:cursor-not-allowed border border-[#F4F1EA]/15 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-xs"
          >
            ←
          </button>
          <button
            type="button"
            id="timeline-scroll-next"
            aria-label="Scroll talks right"
            aria-disabled="false"
            class="min-h-[1.75rem] min-w-[1.75rem] px-1.5 rounded-md flex items-center justify-center bg-[#121417] hover:bg-[#181B20] aria-disabled:opacity-35 aria-disabled:cursor-not-allowed border border-[#F4F1EA]/15 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-xs"
          >
            →
          </button>
        </div>

        <button
          type="button"
          data-action="open-archive"
          data-testid="view-all-talks-btn"
          class="inline-flex items-center gap-1.5 text-xs font-medium text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer tabular-nums"
        >
          <span>All {metrics.totalTalks} talks</span>
          <span aria-hidden="true" class="text-[#E2A84B]">→</span>
        </button>
      </div>
    </div>

    <!-- Horizontal Chronological Index Cards (Typographic when no photo; real thumbnail when photo exists) -->
    <div
      id="timeline-cards-track"
      data-testid="timeline-cards-track"
      class="flex items-stretch gap-3 overflow-x-auto pb-1 scroll-smooth soft-edge-fade-x custom-scrollbar"
    >
      {
        events.map((ev) => {
          const hasAuthenticPhoto = Array.isArray(ev.photos) && ev.photos.length > 0;
          const formatLabel =
            ev.sessionType === 'keynote'
              ? 'Keynote'
              : ev.sessionType === 'workshop'
                ? 'Workshop'
                : 'Talk';
          return (
            <article
              data-timeline-card
              data-event-id={ev.id}
              data-city-id={ev.locationId ?? ''}
              data-year={ev.year}
              data-topics={ev.topicCategories.join(',')}
              data-testid={`timeline-card-${ev.id}`}
              tabindex="0"
              role="button"
              aria-label={`${ev.talk} at ${ev.event} (${ev.city})`}
              class="group shrink-0 w-[290px] sm:w-[320px] flex items-center gap-3 rounded-xl px-3.5 py-3 bg-[#121417]/90 hover:bg-[#181B20] backdrop-blur-md border border-[#F4F1EA]/12 hover:border-[#E2A84B]/50 transition-colors cursor-pointer shadow-[0_8px_24px_rgba(0,0,0,0.45)]"
            >
              {hasAuthenticPhoto && (
                <div class="relative w-20 aspect-[4/3] shrink-0 rounded-lg overflow-hidden border border-[#F4F1EA]/14 bg-[#0B0C0E]">
                  <img
                    src={withBase(ev.photos[0])}
                    alt={`${ev.event} in ${ev.city}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}

              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2 text-[0.6875rem]">
                  <span class="font-mono text-[#9C978C] truncate">
                    {formatSignalDate(ev.date)} · {ev.cityName}
                  </span>
                  <span
                    class={`shrink-0 font-medium ${
                      ev.sessionType === 'keynote' || ev.sessionType === 'workshop'
                        ? 'text-[#E2A84B]'
                        : 'text-[#9C978C]'
                    }`}
                  >
                    {formatLabel}
                  </span>
                </div>

                <h3 class="mt-1 text-[0.8125rem] font-semibold text-[#F4F1EA] truncate group-hover:text-white">
                  {ev.talk}
                </h3>

                <p class="mt-0.5 text-xs text-[#9C978C] truncate">
                  {ev.event}
                </p>
              </div>
            </article>
          );
        })
      }
      <div
        id="timeline-strip-empty-state"
        class="hidden w-full py-5 px-4 text-center rounded-xl bg-[#121417]/90 border border-[#F4F1EA]/12 text-xs text-[#C6C2B8]"
      >
        <span>No talks match the selected year and topic filters.</span>
        <button
          type="button"
          data-action="clear-timeline-filters"
          class="ml-3 font-medium text-[#E2A84B] hover:underline cursor-pointer"
        >
          Reset filters
        </button>
      </div>
    </div>
  </div>
</section>
