---
import type { EnrichedSpeakingEvent } from '../utils/geography';
import { formatSignalDate } from '../utils/paths';

interface Props {
  initialEvent: EnrichedSpeakingEvent;
}

const { initialEvent } = Astro.props;
---

<!-- Slide-Over Backdrop -->
<div
  id="signal-drawer-backdrop"
  data-testid="signal-drawer-backdrop"
  data-action="close-drawer"
  aria-hidden="true"
  class="fixed inset-0 z-40 hidden bg-black/65 backdrop-blur-sm transition-opacity duration-300"
>
</div>

<!-- Right-Hand Slide-Over Event Detail Dossier Drawer -->
<aside
  id="signal-drawer"
  data-testid="signal-drawer"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="signal-drawer-title"
  class="fixed top-0 right-0 bottom-0 z-50 hidden w-full max-w-lg bg-[#060C1C]/95 backdrop-blur-2xl border-l border-white/15 shadow-[-24px_0_64px_rgba(0,0,0,0.85)] overflow-y-auto transition-transform duration-300"
>
  <div class="p-6 sm:p-8 flex flex-col min-h-full">
    <!-- Top Header & Close Action -->
    <div class="flex items-center justify-between pb-4 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#38BDF8] shadow-[0_0_10px_#38BDF8]"></span>
        <span class="font-mono text-[11px] font-semibold tracking-[0.22em] uppercase text-slate-300">
          SPEAKING ENGAGEMENT DOSSIER
        </span>
      </div>
      <button
        type="button"
        data-action="close-drawer"
        data-testid="close-drawer-btn"
        aria-label="Close Event Dossier"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.06] hover:bg-white/[0.15] border border-white/15 text-slate-300 hover:text-white transition-colors cursor-pointer text-lg leading-none"
      >
        ×
      </button>
    </div>

    <!-- Metadata Grid -->
    <div class="mt-4 grid grid-cols-2 gap-2.5 rounded-xl p-3.5 bg-slate-900/75 border border-white/10 font-mono text-[11px]">
      <div>
        <span class="text-slate-500 block text-[9px] tracking-widest uppercase">FORMAT</span>
        <span id="drawer-type" class="text-[#38BDF8] font-semibold uppercase">
          {initialEvent.sessionType}
        </span>
      </div>
      <div>
        <span class="text-slate-500 block text-[9px] tracking-widest uppercase">DATE</span>
        <span id="drawer-date" class="text-slate-200">
          {formatSignalDate(initialEvent.date)}
        </span>
      </div>
      <div>
        <span class="text-slate-500 block text-[9px] tracking-widest uppercase">DESTINATION</span>
        <span id="drawer-location" class="text-slate-200">
          {initialEvent.flag} {initialEvent.city}
        </span>
      </div>
      <div>
        <span class="text-slate-500 block text-[9px] tracking-widest uppercase">COORDINATES</span>
        <span id="drawer-coords" class="text-slate-300">
          {
            initialEvent.lat !== null && initialEvent.lon !== null
              ? `${initialEvent.lat.toFixed(4)}°N, ${initialEvent.lon.toFixed(4)}°E`
              : 'Online Broadcast'
          }
        </span>
      </div>
    </div>

    <!-- Authentic Event Photos Container (Hidden when event.photos is empty) -->
    <div id="drawer-photos-wrapper" class="hidden mt-5">
      <div
        id="drawer-photos-grid"
        class="grid grid-cols-1 gap-3 rounded-xl overflow-hidden"
      >
      </div>
    </div>

    <!-- Conference Name & Full Talk Title -->
    <div class="mt-5">
      <p
        id="drawer-event"
        class="font-mono text-xs font-semibold tracking-[0.18em] uppercase text-[#38BDF8]"
      >
        {initialEvent.event}
      </p>
      <h2
        id="signal-drawer-title"
        data-testid="signal-drawer-title"
        class="mt-1.5 font-display text-2xl sm:text-3xl font-bold tracking-tight text-white leading-snug"
      >
        {initialEvent.talk}
      </h2>
    </div>

    <!-- Canonical Technical Topics -->
    <div id="drawer-clusters" class="mt-4 flex flex-wrap gap-1.5">
      {
        initialEvent.topics.map((topic) => (
          <span class="rounded-full px-3 py-1 font-mono text-[10px] tracking-wider uppercase bg-white/10 text-slate-200 border border-white/15">
            {topic}
          </span>
        ))
      }
    </div>

    <!-- Session Description / Syllabus (Preserves paragraph breaks) -->
    <div class="mt-5">
      <h3 class="font-mono text-[10px] tracking-[0.2em] uppercase text-slate-400 mb-2">
        SESSION ABSTRACT & AGENDA
      </h3>
      <p
        id="drawer-summary"
        class="text-sm text-slate-300 leading-relaxed whitespace-pre-line"
      >
        {initialEvent.description}
      </p>
    </div>

    <!-- External Links (Slides, Recording, Event Page, LinkedIn) -->
    <div id="drawer-links" class="mt-6 flex flex-wrap gap-2.5"></div>

    <!-- Navigation back to City Panel or Full Archive -->
    <div class="mt-8 pt-5 border-t border-white/10 flex flex-wrap items-center justify-between gap-3">
      <button
        type="button"
        id="drawer-inspect-city-btn"
        class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold text-white bg-[#1D4ED8]/40 hover:bg-[#1D4ED8]/65 border border-[#38BDF8]/50 transition-colors cursor-pointer"
      >
        <span>Inspect City on Globe</span>
        <span aria-hidden="true">→</span>
      </button>

      <button
        type="button"
        data-action="open-archive"
        class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-medium text-slate-200 hover:text-white bg-white/[0.06] hover:bg-white/[0.12] border border-white/15 transition-colors cursor-pointer"
      >
        <span>Browse All Talks Archive</span>
      </button>
    </div>

    <!-- Other Talks in the Same City / Region -->
    <div class="mt-6 pt-4 border-t border-white/10">
      <h3 class="font-mono text-[10px] tracking-[0.22em] uppercase text-slate-400 mb-3">
        RELATED TALKS IN THIS DESTINATION / REGION
      </h3>
      <div id="drawer-connected" class="flex flex-col gap-2"></div>
    </div>
  </div>
</aside>
