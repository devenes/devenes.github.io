---
import type { EnrichedSpeakingEvent } from '../utils/geography';
import { formatCoordinates, formatSignalDate } from '../utils/paths';

interface Props {
  initialEvent: EnrichedSpeakingEvent;
}

const { initialEvent } = Astro.props;
---

<!-- Slide-Over Talk Detail Sheet -->
<dialog
  id="signal-drawer"
  data-testid="signal-drawer"
  closedby="any"
  aria-hidden="true"
  aria-labelledby="signal-drawer-title"
  class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-full max-w-lg bg-[#121417]/98 text-[#F4F1EA] backdrop-blur-xl border-l border-[#F4F1EA]/15 shadow-[-20px_0_50px_rgba(0,0,0,0.75)] overflow-y-auto p-0"
>
  <div class="p-6 sm:p-8 flex flex-col min-h-full">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-[#F4F1EA]/12">
      <span class="text-xs font-medium text-[#9C978C]">Session details</span>
      <button
        type="button"
        data-action="close-drawer"
        data-testid="close-drawer-btn"
        aria-label="Close session details"
        class="flex min-h-[2rem] min-w-[2rem] items-center justify-center rounded-md bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 text-[#C6C2B8] hover:text-[#F4F1EA] transition-colors cursor-pointer text-base leading-none"
      >
        ×
      </button>
    </div>

    <!-- Event Name & Talk Title -->
    <div class="mt-5">
      <p id="drawer-event" class="text-xs font-medium text-[#E2A84B]">
        {initialEvent.event}
      </p>
      <h2
        id="signal-drawer-title"
        data-testid="signal-drawer-title"
        class="mt-1.5 font-display text-2xl sm:text-3xl font-medium text-[#F4F1EA] leading-[1.18]"
      >
        {initialEvent.talk}
      </h2>
    </div>

    <!-- Metadata Ledger -->
    <div class="mt-5 grid grid-cols-2 gap-3 rounded-lg p-3.5 bg-[#181B20]/80 border border-[#F4F1EA]/12 text-xs">
      <div>
        <span class="text-[#9C978C] block">Date</span>
        <span id="drawer-date" class="mt-0.5 block font-mono text-[#F4F1EA]">
          {formatSignalDate(initialEvent.date)}
        </span>
      </div>
      <div>
        <span class="text-[#9C978C] block">Format</span>
        <span id="drawer-type" class="mt-0.5 block font-medium capitalize text-[#F4F1EA]">
          {initialEvent.sessionType}
        </span>
      </div>
      <div>
        <span class="text-[#9C978C] block">Location</span>
        <span id="drawer-location" class="mt-0.5 block text-[#F4F1EA]">
          {initialEvent.flag} {initialEvent.city}
        </span>
      </div>
      <div>
        <span class="text-[#9C978C] block">Coordinates</span>
        <span id="drawer-coords" class="mt-0.5 block font-mono text-[#C6C2B8] tabular-nums">
          {
            initialEvent.lat !== null && initialEvent.lon !== null
              ? formatCoordinates(initialEvent.lat, initialEvent.lon, 4)
              : 'Online'
          }
        </span>
      </div>
    </div>

    <!-- Authentic Event Photos (Automatically shown once photos are added to data/events.json) -->
    <div id="drawer-photos-wrapper" class="hidden mt-5">
      <div id="drawer-photos-grid" class="grid grid-cols-1 gap-3 rounded-lg overflow-hidden">
      </div>
    </div>

    <!-- Topics -->
    <div id="drawer-clusters" class="mt-4 flex flex-wrap gap-1.5">
      {
        initialEvent.topics.map((topic) => (
          <span class="rounded-md px-2.5 py-1 text-xs bg-[#181B20] text-[#C6C2B8] border border-[#F4F1EA]/12">
            {topic}
          </span>
        ))
      }
    </div>

    <!-- Session Description -->
    <div class="mt-5">
      <h3 class="text-xs font-medium text-[#9C978C] mb-2">Notes &amp; abstract</h3>
      <p
        id="drawer-summary"
        class="max-w-[60ch] text-sm text-[#C6C2B8] leading-[1.6] whitespace-pre-line"
      >
        {initialEvent.description}
      </p>
    </div>

    <!-- External Links (Slides, Video, Event Page, LinkedIn) -->
    <div id="drawer-links" class="mt-6 flex flex-wrap gap-2"></div>

    <!-- Actions -->
    <div class="mt-8 pt-5 border-t border-[#F4F1EA]/12 flex flex-wrap items-center justify-between gap-3">
      <button
        type="button"
        id="drawer-inspect-city-btn"
        class="inline-flex items-center gap-2 rounded-md px-3.5 py-2 text-xs font-semibold text-[#0B0C0E] bg-[#F4F1EA] hover:bg-white transition-colors cursor-pointer"
      >
        <span>Show on globe</span>
        <span aria-hidden="true">→</span>
      </button>

      <button
        type="button"
        data-action="open-archive"
        class="inline-flex items-center gap-2 rounded-md px-3.5 py-2 text-xs font-medium text-[#E6E2D8] hover:text-[#F4F1EA] bg-[#181B20] hover:bg-[#22262D] border border-[#F4F1EA]/16 transition-colors cursor-pointer"
      >
        <span>All talks archive</span>
      </button>
    </div>

    <!-- Other Talks in City / Region -->
    <div class="mt-6 pt-4 border-t border-[#F4F1EA]/12">
      <h3 class="text-xs font-medium text-[#9C978C] mb-3">
        Other sessions in this city &amp; region
      </h3>
      <div id="drawer-connected" class="flex flex-col gap-2"></div>
    </div>
  </div>
</dialog>
